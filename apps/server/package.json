{
  "name": "@coedit/server",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "tsc/index.d.ts",
  "scripts": {
    "dev": "wrangler dev src/index.ts --config wrangler.dev.toml --port 5000",
    "deploy": "wrangler deploy --minify src/index.ts --config wrangler.prod.toml",
    "tsc:clean": "rm -rf tsc tsconfig.tsbuildinfo",
    "tsc:build": "tsc --build",
    "tsc": "run-s tsc:clean tsc:build",
    "gen:jwt-secret": "bun run jwt-secret.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@coedit/db": "workspace:*",
    "@coedit/id": "workspace:*",
    "@coedit/kv": "workspace:*",
    "@coedit/orchestration": "workspace:*",
    "@coedit/r": "workspace:*",
    "@coedit/zschema": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "@smithy/fetch-http-handler": "^5.3.15",
    "@xmldom/xmldom": "^0.8.11",
    "await-to-js": "^3.0.0",
    "aws4fetch": "^1.0.20",
    "hono": "4.12.8",
    "jose": "^6.2.1",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "resend": "^6.9.3",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@types/ms": "^2.1.0",
    "wrangler": "^4.73.0"
  }
}
