{
  "name": "@coedit/server",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "tsc/index.d.ts",
  "scripts": {
    "dev": "wrangler dev src/index.ts --test-scheduled --config wrangler.dev.toml",
    "deploy": "wrangler deploy --minify src/index.ts --config wrangler.prod.toml",
    "tsc:clean": "rm -rf tsc tsconfig.tsbuildinfo",
    "tsc:build": "tsc --build",
    "tsc": "run-s tsc:clean tsc:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-presigned-post": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@coedit/db": "workspace:*",
    "@coedit/id": "workspace:*",
    "@coedit/kv": "workspace:*",
    "@coedit/orchestration": "workspace:*",
    "@coedit/r": "workspace:*",
    "@coedit/zschema": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@xmldom/xmldom": "^0.8.11",
    "await-to-js": "^3.0.0",
    "better-auth": "^1.6.23",
    "files-sdk": "^2.1.0",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "random-words": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@types/bun": "^1.3.14",
    "@types/ms": "^2.1.0",
    "@types/pg": "^8.20.0",
    "wrangler": "^4.111.0"
  }
}
