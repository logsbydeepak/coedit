# Copy to `.dev.vars` and fill in real values for local development.
# In production, set these with `wrangler secret put <NAME>` or the dashboard.

RUNTIME="development" # development OR production

# Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
CORS_ORIGIN="http://localhost:5001"
COOKIE_DOMAIN="localhost"
MACHINE_SECRET=""

# Orchestration
ORCHESTRATION_MODE="mock" # mock OR caddy
ORCHESTRATION_URL="http://localhost:5002"
CONTAINER_MODE="mock" # mock OR caddy

# Database (neon/supabase postgres)
DB_URL=""

# Redis (upstash)
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""

# S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""
